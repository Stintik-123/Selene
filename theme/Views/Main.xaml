<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
                    xmlns:pbeh="clr-namespace:Playnite.Behaviors;assembly=Playnite"
                    xmlns:pin="clr-namespace:Playnite.Input;assembly=Playnite"
                    mc:Ignorable="d">

    <!-- Selene main screen. Layers, bottom to top:
           SeleneLibrary      Playnite's own game grid + filters (opened from the Library card, B goes home)
           WelcomeHubOverlay  the home: art, game row, logo, Play/Details/Favourite, info, screenshots
           top bar            filter tabs (home) / filter presets (library), clock, notifications, menu
           AcceuilSettings    the login (Selene Core builds its scene into LoginCenterShell and removes the layer)
         Element names are what Selene Core looks for - keep them when restyling. -->
    <Style TargetType="{x:Type Main}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Main}">
                    <Grid x:Name="PART_MainHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                        <Grid.Resources>
                            <FontFamily x:Key="FontMain">Segoe UI Variable Display</FontFamily>
                        </Grid.Resources>
                        <Grid x:Name="PART_ViewHost" Background="{DynamicResource SeleneScrimBrush}">

                            <!-- ================= LIBRARY (Playnite's grid) ================= -->
                            <Grid x:Name="SeleneLibrary" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="110" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Grid.RowSpan="3" Background="{DynamicResource MainBackgourndBrush}"/>
                                <Image Grid.RowSpan="3" Source="{DynamicResource SeleneWallpaper}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant" Opacity="0.6"/>
                                <FadeImage x:Name="PART_ImageBackground" Grid.RowSpan="3" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.35"/>
                                <DockPanel Grid.Row="1">
                                    <Filters x:Name="PART_ElemFilters" DockPanel.Dock="Left" Focusable="False" />
                                    <FiltersAdditional x:Name="PART_ElemFiltersAdditional" DockPanel.Dock="Left" Focusable="False" />
                                    <ContentControl x:Name="PART_ContentFilterItems" DockPanel.Dock="Left" Focusable="False" />
                                    <ListBoxEx x:Name="PART_ListGameItems" Margin="25,0,25,0" Background="Transparent" BorderThickness="0"
                                               DockPanel.Dock="Right" KeyboardNavigation.DirectionalNavigation="Once" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" FontSize="40" Text="{DynamicResource LOCNoGamesFound}" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextBlockBaseStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGameItems}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Grid Grid.Row="2" Height="100">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ButtonEx x:Name="PART_ButtonInstall" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCInstallGame}" />
                                        <ButtonEx x:Name="PART_ButtonPlay" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCPlayGame}" />
                                        <ButtonEx x:Name="PART_ButtonDetails" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCGameDetails}" />
                                        <ButtonEx x:Name="PART_ButtonGameOptions" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCGameOptions}" />
                                        <ButtonEx x:Name="PART_ButtonSearch" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCSearchLabel}" />
                                        <ButtonEx x:Name="PART_ButtonFilter" Style="{DynamicResource ButtonBottomMenu}" Content="{DynamicResource LOCFilter}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" x:Name="PART_ElemSearchActive" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,15,0,0">
                                        <TextBlock FontSize="18" TextAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" Text="{DynamicResource LOCGameListSearchResults}"/>
                                        <TextBlock Foreground="{DynamicResource TextBrush}" TextAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" Text="{Binding AppSettings.Fullscreen.FilterSettings.Name}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" x:Name="PART_ElemExtraFilterActive" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                               TextAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}" Text="{DynamicResource LOCGameListExtraFiltered}"/>
                                    <StackPanel x:Name="PART_ElemProgressIndicator" Orientation="Horizontal" Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock x:Name="PART_TextProgressTooltip" Margin="0,0,15,0" FontSize="20" VerticalAlignment="Center" Style="{DynamicResource TextBlockBaseStyle}"/>
                                        <ContentControl Style="{DynamicResource ProgressIndicator}" Focusable="False" Height="38" Width="38" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- ================= HOME ================= -->
                            <Grid x:Name="WelcomeHubOverlay">
                                <!-- selected game's art: Selene's hero art (media folder) over Playnite's background -->
                                <Grid x:Name="SeleneHubGameBackground" IsHitTestVisible="False">
                                    <!-- fallback for when no game is selected (empty library): the theme's gradient and the profile's wallpaper -->
                                    <Border Background="{DynamicResource MainBackgourndBrush}"/>
                                    <Image Source="{DynamicResource SeleneWallpaper}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
                                    <!-- the game's art; the wallpaper shows where there is none (or always, for a profile that wants that) -->
                                    <Grid x:Name="SeleneHubArt" Opacity="{DynamicResource SeleneArtOpacity}">
                                    <FadeImage Source="{Binding SelectedGame.DisplayBackgroundImage}" SourceUpdateDelay="250" AnimationEnabled="True" RenderOptions.BitmapScalingMode="Fant"/>
                                    <TextBlock x:Name="SeleneHeroPath" Tag="{DynamicResource SeleneMediaRoot}" Visibility="Collapsed">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}\Hero\{1}.jpg">
                                                <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                <Binding Path="SelectedGame.Id"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <FadeImage Source="{Binding Text, ElementName=SeleneHeroPath}" SourceUpdateDelay="250" AnimationEnabled="True" RenderOptions.BitmapScalingMode="Fant"/>
                                    </Grid>
                                    <Border Background="{DynamicResource SeleneScrimBrush}">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#E0000000" Offset="0"/>
                                                <GradientStop Color="#80000000" Offset="0.5"/>
                                                <GradientStop Color="#26000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                    <Border Background="{DynamicResource SeleneScrimBrush}">
                                        <Border.OpacityMask>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0.4"/>
                                                <GradientStop Color="#E6000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.OpacityMask>
                                    </Border>
                                </Grid>

                                <!-- actions Selene Core wires up (home <-> library) -->
                                <ButtonEx x:Name="SeleneNav_library" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_hub" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>
                                <ButtonEx x:Name="SeleneNav_store" Visibility="Collapsed" Focusable="False" IsTabStop="False"/>

                                <Grid Margin="0,120,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="HubTopProfileSummary" Grid.Row="0" Margin="80,0,80,0" RenderTransformOrigin="0.5,0.5"
                                          KeyboardNavigation.DirectionalNavigation="Continue">
                                        <Grid.RenderTransform>
                                            <TranslateTransform x:Name="HubTopProfileSummaryShift" Y="0"/>
                                        </Grid.RenderTransform>
                                        <Grid.Resources>
                                            <CollectionViewSource x:Key="SeleneGames" Source="{Binding GamesView.CollectionView.SourceCollection}">
                                                <CollectionViewSource.SortDescriptions>
                                                    <scm:SortDescription PropertyName="LastActivity" Direction="Descending"/>
                                                </CollectionViewSource.SortDescriptions>
                                            </CollectionViewSource>

                                            <Style x:Key="SeleneTileStyle" TargetType="ListBoxItem">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="pbeh:FocusBahaviors.FocusBinding" Value="{Binding IsSelected, RelativeSource={RelativeSource Self}}"/>
                                                <Setter Property="Margin" Value="1,3,3,0"/>
                                                <Setter Property="VerticalAlignment" Value="Top"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <StackPanel>
                                                                <Grid x:Name="TileHost">
                                                                    <Grid.LayoutTransform><ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
                                                                    <Border x:Name="Tile" Margin="7" Width="160" Height="160" CornerRadius="14" BorderThickness="0" BorderBrush="{DynamicResource SeleneFocusBrush}" ClipToBounds="False" Background="{DynamicResource SeleneInk15Brush}">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.55" Color="Black"/>
                                                                        </Border.Effect>
                                                                        <Grid>
                                                                            <Border CornerRadius="12">
                                                                                <Border.Background>
                                                                                    <ImageBrush ImageSource="{Binding CoverImage, Converter={StaticResource ImageStringToImageConverterCached}}" Stretch="UniformToFill" AlignmentY="Top"/>
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <!-- square tile art from Selene's media folder; the cover stays underneath as the fallback -->
                                                                            <TextBlock x:Name="SquarePath" Tag="{DynamicResource SeleneMediaRoot}" Visibility="Collapsed">
                                                                                <TextBlock.Text>
                                                                                    <MultiBinding StringFormat="{}{0}\Square\{1}.jpg">
                                                                                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                                                        <Binding Path="Id"/>
                                                                                    </MultiBinding>
                                                                                </TextBlock.Text>
                                                                            </TextBlock>
                                                                            <Border CornerRadius="12">
                                                                                <Border.Background>
                                                                                    <ImageBrush ImageSource="{Binding Text, ElementName=SquarePath, Converter={StaticResource ImageStringToImageConverterCached}}" Stretch="UniformToFill"/>
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <!-- Selene Core plays the selected tile's trailer here -->
                                                                            <Grid x:Name="TileVideoHost" IsHitTestVisible="False"/>
                                                                            <Border x:Name="Shine" CornerRadius="12" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource SeleneFocusBrush}">
                                                                                <Border.OpacityMask>
                                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.6">
                                                                                        <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="ShineShift" X="-1.5"/></LinearGradientBrush.RelativeTransform>
                                                                                        <GradientStop Color="#00FFFFFF" Offset="0.2"/>
                                                                                        <GradientStop Color="#0AFFFFFF" Offset="0.38"/>
                                                                                        <GradientStop Color="#2EFFFFFF" Offset="0.5"/>
                                                                                        <GradientStop Color="#0AFFFFFF" Offset="0.62"/>
                                                                                        <GradientStop Color="#00FFFFFF" Offset="0.8"/>
                                                                                    </LinearGradientBrush>
                                                                                </Border.OpacityMask>
                                                                            </Border>
                                                                            <Border x:Name="CardFace" CornerRadius="12" Background="{DynamicResource SeleneGlassBrush}" BorderBrush="{DynamicResource SeleneInk15Brush}" BorderThickness="1" Visibility="Collapsed">
                                                                                <TextBlock x:Name="CardGlyph" FontFamily="Segoe MDL2 Assets" FontSize="56" Foreground="{DynamicResource SeleneInkBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                            </Border>
                                                                        </Grid>
                                                                    </Border>
                                                                    <!-- selection ring with a highlight travelling around it -->
                                                                    <Border x:Name="Ring" Margin="0" CornerRadius="19" BorderThickness="3" Opacity="0" IsHitTestVisible="False" BorderBrush="{DynamicResource SeleneFocusBrush}">
                                                                        <Border.Effect><DropShadowEffect x:Name="RingGlow" Color="{DynamicResource SeleneFocusColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.25"/></Border.Effect>
                                                                        <Border.OpacityMask>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                                <LinearGradientBrush.RelativeTransform><RotateTransform x:Name="RingSpin" CenterX="0.5" CenterY="0.5" Angle="0"/></LinearGradientBrush.RelativeTransform>
                                                                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                                                <GradientStop Color="#E6FFFFFF" Offset="0.25"/>
                                                                                <GradientStop Color="#99FFFFFF" Offset="0.5"/>
                                                                                <GradientStop Color="#E6FFFFFF" Offset="0.75"/>
                                                                                <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                                                            </LinearGradientBrush>
                                                                        </Border.OpacityMask>
                                                                    </Border>
                                                                    <!-- trailer sound state (R3) -->
                                                                    <Border x:Name="SoundBadge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource SeleneScrim45Brush}" BorderBrush="{DynamicResource SeleneInk25Brush}" BorderThickness="1" IsHitTestVisible="False">
                                                                        <TextBlock x:Name="SoundGlyph" Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource SeleneInk90Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>
                                                                <Canvas Height="44" ClipToBounds="False">
                                                                    <TextBlock x:Name="TileName" Text="{Binding DisplayName}" Visibility="Collapsed" Foreground="{DynamicResource SeleneInkBrush}" FontSize="22"
                                                                               FontFamily="{DynamicResource FontMain}" Canvas.Top="14" Canvas.Left="2" Width="420" TextTrimming="CharacterEllipsis"/>
                                                                </Canvas>
                                                            </StackPanel>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Trigger.EnterActions>
                                                                        <BeginStoryboard x:Name="TileFx">
                                                                            <Storyboard>
                                                                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ShineShift" Storyboard.TargetProperty="X" RepeatBehavior="Forever">
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-1.5"/>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="-1.5"/>
                                                                                    <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="1.5"><EasingDoubleKeyFrame.EasingFunction><SineEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction></EasingDoubleKeyFrame>
                                                                                    <DiscreteDoubleKeyFrame KeyTime="0:0:5" Value="1.5"/>
                                                                                </DoubleAnimationUsingKeyFrames>
                                                                                <DoubleAnimation Storyboard.TargetName="RingSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:5" RepeatBehavior="Forever"/>
                                                                                <DoubleAnimation Storyboard.TargetName="RingGlow" Storyboard.TargetProperty="Opacity" From="0.2" To="0.55" Duration="0:0:1.8" AutoReverse="True" RepeatBehavior="Forever">
                                                                                    <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                                                                                </DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.3" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.3" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.EnterActions>
                                                                    <Trigger.ExitActions>
                                                                        <RemoveStoryboard BeginStoryboardName="TileFx"/>
                                                                        <BeginStoryboard>
                                                                            <Storyboard>
                                                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                                                <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </Trigger.ExitActions>
                                                                    <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                                                                    <Setter TargetName="Shine" Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:library">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardGlyph" Property="Text" Value="&#xE8F1;"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding}" Value="nav:store">
                                                                    <Setter TargetName="CardFace" Property="Visibility" Value="Visible"/>
                                                                    <Setter TargetName="CardGlyph" Property="Text" Value="&#xE719;"/>
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Panel.ZIndex" Value="10"/></Trigger>
                                                    <DataTrigger Binding="{Binding Hidden}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                </Style.Triggers>
                                            </Style>

                                            <!-- Play / Details / Favourite pills (focused = white) -->
                                            <ControlTemplate x:Key="SelenePill" TargetType="Button">
                                                <Grid RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                                    <Grid.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                                    <Border x:Name="Glow" CornerRadius="26" Background="{DynamicResource SeleneFocusBrush}" Opacity="0"><Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="22" Color="{DynamicResource SeleneFocusColor}" Opacity="0.4"/></Border.Effect></Border>
                                                    <Border x:Name="Pill" CornerRadius="26" Height="52" MinWidth="{TemplateBinding MinWidth}" Padding="{TemplateBinding Padding}" Background="{DynamicResource SeleneInk15Brush}" BorderBrush="{DynamicResource SeleneInk25Brush}" BorderThickness="1">
                                                        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource SeleneInkBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SeleneFocusBrush}"/>
                                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource SeleneFocusBrush}"/>
                                                        <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource SeleneOnFocusBrush}"/>
                                                        <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15"/>
                                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                            <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Grid.Resources>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="270"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- game row (Selene Core fills it, keeps the selection's slot, plays trailers) -->
                                        <Grid x:Name="SeleneRowIntro" Grid.Row="0" RenderTransformOrigin="0.5,0.3">
                                            <Grid.RenderTransform><ScaleTransform x:Name="SeleneRowIntroScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                            <ListBoxEx x:Name="SeleneGameRow" Margin="-8,10,-80,-70" Tag="{DynamicResource SeleneRowMode}"
                                                       SelectedIndex="1"
                                                       ItemContainerStyle="{StaticResource SeleneTileStyle}"
                                                       pbeh:FocusBahaviors.OnVisibilityFocus="True"
                                                       Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}"
                                                       ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                       ScrollViewer.CanContentScroll="True"
                                                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.CacheLengthUnit="Item" VirtualizingPanel.CacheLength="12,16"
                                                       KeyboardNavigation.DirectionalNavigation="Continue">
                                                <ListBoxEx.ItemsSource>
                                                    <CompositeCollection>
                                                        <sys:String>nav:library</sys:String>
                                                        <sys:String>nav:store</sys:String>
                                                        <CollectionContainer Collection="{Binding Source={StaticResource SeleneGames}}"/>
                                                    </CompositeCollection>
                                                </ListBoxEx.ItemsSource>
                                                <ListBoxEx.InputBindings>
                                                    <KeyBinding Key="Enter" Command="{Binding ActivateSelectedCommand}"/>
                                                </ListBoxEx.InputBindings>
                                                <ListBoxEx.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <VirtualizingStackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ListBoxEx.ItemsPanel>
                                            </ListBoxEx>
                                            <!-- selected game's name; placed under the selected tile by Selene Core -->
                                            <Canvas IsHitTestVisible="False" ClipToBounds="False">
                                                <TextBlock x:Name="SeleneTileTitle" Foreground="{DynamicResource SeleneInkBrush}" FontSize="22" FontFamily="{DynamicResource FontMain}" Opacity="0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding SelectedItem.DisplayName, ElementName=SeleneGameRow}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:library">
                                                                    <Setter Property="Text" Value="{DynamicResource LOCLibrary}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:store">
                                                                    <Setter Property="Text" Value="Store"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Canvas>
                                            <!-- the tab has no games: what it is and how it fills up (Selene Core sets the text and shows it) -->
                                            <StackPanel x:Name="SeleneRowEmpty" Margin="440,46,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                                                <TextBlock x:Name="SeleneRowEmptyTitle" Foreground="{DynamicResource SeleneInkBrush}" FontSize="30" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold"/>
                                                <TextBlock x:Name="SeleneRowEmptyHint" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="19" FontFamily="{DynamicResource FontMain}" Margin="0,8,0,0" MaxWidth="760" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- selected game: logo, actions, info -->
                                        <Grid x:Name="SeleneInfoIntro" Grid.Row="1" HorizontalAlignment="Left">
                                            <Grid.RenderTransform><TranslateTransform x:Name="SeleneInfoIntroShift" Y="0"/></Grid.RenderTransform>
                                            <!-- the library card selected: what it is, a few numbers, what A does -->
                                            <StackPanel Margin="0,40,0,0" HorizontalAlignment="Left" Width="900" Opacity="0">
                                                <StackPanel.RenderTransform><TranslateTransform X="0"/></StackPanel.RenderTransform>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:library">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" From="-30" To="0" BeginTime="0:0:0.12" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/></Storyboard></BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Library" Foreground="{DynamicResource SeleneInkBrush}" FontSize="64" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,60,0,0"/>
                                                <TextBlock Text="Every game you have in one place: filter, search and sort the whole collection." Foreground="{DynamicResource SeleneInk90Brush}" FontSize="22" FontFamily="{DynamicResource FontMain}" TextWrapping="Wrap" Margin="2,10,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="4,30,0,0">
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="GAMES" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{DynamicResource SeleneStatGames}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="INSTALLED" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{DynamicResource SeleneStatInstalled}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="PLAYED THIS MONTH" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{DynamicResource SeleneStatRecent}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="2,34,0,0">
                                                    <Grid Width="32" Height="32">
                                                        <Ellipse Fill="{DynamicResource SeleneInkBrush}"/>
                                                        <TextBlock Text="A" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneScrimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="Open your library" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="21" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center" Margin="10,0,0,2"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- the store card selected: what it is, a few numbers, what A does -->
                                            <StackPanel Margin="0,40,0,0" HorizontalAlignment="Left" Width="900" Opacity="0">
                                                <StackPanel.RenderTransform><TranslateTransform X="0"/></StackPanel.RenderTransform>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:store">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" From="-30" To="0" BeginTime="0:0:0.12" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/></Storyboard></BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="Store" Foreground="{DynamicResource SeleneInkBrush}" FontSize="64" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,60,0,0"/>
                                                <TextBlock Text="Find something new in the store apps on this PC. Selene is here when you come back." Foreground="{DynamicResource SeleneInk90Brush}" FontSize="22" FontFamily="{DynamicResource FontMain}" TextWrapping="Wrap" Margin="2,10,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="4,30,0,0">
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="STORES" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{DynamicResource SeleneStatStores}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="2,34,0,0">
                                                    <Grid Width="32" Height="32">
                                                        <Ellipse Fill="{DynamicResource SeleneInkBrush}"/>
                                                        <TextBlock Text="A" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneScrimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <TextBlock Text="Choose a store" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="21" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center" Margin="10,0,0,2"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Margin="0,30,0,0" HorizontalAlignment="Left" Width="900">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:library">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=SeleneGameRow}" Value="nav:store">
                                                                <Setter Property="Visibility" Value="Hidden"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock x:Name="SeleneLogoPath" Tag="{Api Paths.ConfigurationPath}" Visibility="Collapsed">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}\ExtraMetadata\games\{1}\logo.png">
                                                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                                            <Binding Path="SelectedGame.Id"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <Grid Height="170" HorizontalAlignment="Left">
                                                    <Image x:Name="SeleneLogo" Source="{Binding ElementName=SeleneLogoPath, Path=Text, Converter={StaticResource ImageStringToImageConverter}, NotifyOnTargetUpdated=True}"
                                                           MaxWidth="620" MaxHeight="170" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="Fant">
                                                        <Image.RenderTransform><TranslateTransform x:Name="LogoShift" X="0"/></Image.RenderTransform>
                                                        <Image.Triggers>
                                                            <EventTrigger RoutedEvent="Binding.TargetUpdated">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
                                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="1"/>
                                                                        </DoubleAnimationUsingKeyFrames>
                                                                        <DoubleAnimation Storyboard.TargetName="LogoShift" Storyboard.TargetProperty="X" From="-30" To="0" BeginTime="0:0:0.3" Duration="0:0:0.4">
                                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Image.Triggers>
                                                    </Image>
                                                    <!-- no logo: the name as text -->
                                                    <TextBlock Text="{Binding SelectedGame.DisplayName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="56" FontFamily="{DynamicResource FontMain}"
                                                               VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ElementName=SeleneLogo, Path=Source}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>

                                                <!-- running: "now playing" chip -->
                                                <Border HorizontalAlignment="Left" Margin="2,24,0,0" CornerRadius="19" Padding="12,6,18,7" Background="{DynamicResource SeleneGlassLightBrush}" BorderBrush="{DynamicResource SeleneInk25Brush}" BorderThickness="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedGame.IsRunning}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,9,0">
                                                            <Ellipse Fill="{DynamicResource SeleneSuccessBrush}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                                                <Ellipse.RenderTransform><ScaleTransform ScaleX="0.5" ScaleY="0.5"/></Ellipse.RenderTransform>
                                                                <Ellipse.Triggers>
                                                                    <EventTrigger RoutedEvent="Loaded">
                                                                        <BeginStoryboard>
                                                                            <Storyboard RepeatBehavior="Forever">
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="0.5" To="1" Duration="0:0:1.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="0.5" To="1" Duration="0:0:1.4"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.45" To="0" Duration="0:0:1.4"/>
                                                                            </Storyboard>
                                                                        </BeginStoryboard>
                                                                    </EventTrigger>
                                                                </Ellipse.Triggers>
                                                            </Ellipse>
                                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource SeleneSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Grid>
                                                        <TextBlock Text="NOW PLAYING" Foreground="{DynamicResource SeleneSuccessBrush}" FontSize="14" FontWeight="Bold" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                                                        <Border Width="1" Height="18" Background="{DynamicResource SeleneInk25Brush}" Margin="14,0,14,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Continue where you left off" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="17" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" Margin="2,18,0,0">
                                                    <Button x:Name="SelenePlayBtn" Template="{StaticResource SelenePill}" MinWidth="180" Padding="36,0" Height="60" Margin="0,0,14,0"
                                                            VerticalAlignment="Center" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                                        <TextBlock FontSize="21" FontFamily="{DynamicResource FontMain}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Play"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedGame.IsRunning}" Value="True"><Setter Property="Text" Value="Resume"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button x:Name="SeleneDetailsBtn" Template="{StaticResource SelenePill}" MinWidth="180" Padding="36,0" Height="60"
                                                            VerticalAlignment="Center" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                                        <TextBlock FontSize="21" FontFamily="{DynamicResource FontMain}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Details"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding SelectedGame.IsRunning}" Value="True"><Setter Property="Text" Value="Close Game"/></DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button x:Name="SeleneFavBtn" ToolTip="Favorite" Template="{StaticResource SelenePill}" MinWidth="52" Width="52" Padding="0" Height="60" Margin="14,0,0,0"
                                                            VerticalAlignment="Center" Focusable="True" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                                        <!-- the signed-in profile's favorite (Selene Core sets the glyph) -->
                                                        <TextBlock FontSize="20" FontFamily="Segoe MDL2 Assets" Text="{DynamicResource SeleneHeartGlyph}"/>
                                                    </Button>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="4,26,0,0">
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="PLAYTIME" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{Binding SelectedGame.Playtime, Mode=OneWay, Converter={StaticResource PlayTimeToStringConverter}}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                                    <StackPanel Margin="0,0,26,0">
                                                        <TextBlock Text="LAST PLAYED" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{Binding SelectedGame.LastActivity, Mode=OneWay, StringFormat='{}{0:MMM d, yyyy}', TargetNullValue=Never}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,26,4"/>
                                                    <StackPanel>
                                                        <TextBlock Text="PLATFORM" Foreground="{DynamicResource SeleneInk60Brush}" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                                        <TextBlock Text="{Binding SelectedGame.Source.Name, Mode=OneWay, TargetNullValue=PC, FallbackValue=PC}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="{DynamicResource FontMain}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- the selected game's screenshots (Selene Core publishes SeleneShot0-5 / SeleneShotsNone); A opens the viewer -->
                                    <Grid x:Name="HubBottomCards" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="80,34,0,0" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform><TranslateTransform x:Name="HubBottomCardsShift" Y="0"/></Grid.RenderTransform>
                                        <Grid.Resources>
                                            <Style x:Key="SeleneShotTileStyle" TargetType="ButtonEx">
                                                <Setter Property="Focusable" Value="True"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Margin" Value="0,0,22,0"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ButtonEx">
                                                            <Grid RenderTransformOrigin="0.5,0.5">
                                                                <Grid.RenderTransform><ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                                                                <Border Width="448" Height="252" CornerRadius="14" Background="{DynamicResource SeleneGlassSolidBrush}" ClipToBounds="True">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <Border x:Name="TileRing" CornerRadius="17" Margin="-4" BorderBrush="{DynamicResource SeleneFocusBrush}" BorderThickness="3" Opacity="0" IsHitTestVisible="False"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                                    <Setter TargetName="TileRing" Property="Opacity" Value="1"/>
                                                                    <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15"/>
                                                                    </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                                                    <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                                                        <DoubleAnimation Storyboard.TargetName="TileScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                                                                    </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Grid.Resources>
                                        <StackPanel>
                                            <TextBlock Text="No screenshots for this game" FontSize="18" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInk60Brush}" Visibility="{DynamicResource SeleneShotsNone}"/>
                                            <ScrollViewer x:Name="SeleneShotStrip" Width="1780" Margin="-10,-10,0,0" Padding="10" Focusable="False" CanContentScroll="False"
                                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="SeleneShotTiles" Orientation="Horizontal">
                                                    <ButtonEx x:Name="SeleneShotTile0" Tag="0" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot0Vis}">
                                                        <Image Source="{DynamicResource SeleneShot0}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile1" Tag="1" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot1Vis}">
                                                        <Image Source="{DynamicResource SeleneShot1}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile2" Tag="2" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot2Vis}">
                                                        <Image Source="{DynamicResource SeleneShot2}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile3" Tag="3" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot3Vis}">
                                                        <Image Source="{DynamicResource SeleneShot3}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile4" Tag="4" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot4Vis}">
                                                        <Image Source="{DynamicResource SeleneShot4}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                    <ButtonEx x:Name="SeleneShotTile5" Tag="5" Style="{StaticResource SeleneShotTileStyle}" Visibility="{DynamicResource SeleneShot5Vis}">
                                                        <Image Source="{DynamicResource SeleneShot5}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </ButtonEx>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>

                            <!-- ================= TOP BAR (home + library) ================= -->
                            <Grid x:Name="HubTopBarBackground" VerticalAlignment="Top" Height="110" Margin="64,0,64,0">
                                <!-- home: LT/RT filter tabs (drawn by Selene Core) -->
                                <StackPanel x:Name="SeleneFilterTabs" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Visibility="{Binding Visibility, ElementName=WelcomeHubOverlay}"/>
                                <!-- library: Playnite's filter presets -->
                                <FilterPresetSelector x:Name="PART_FilterPresetSelector" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Visibility="{Binding Visibility, ElementName=SeleneLibrary}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ButtonEx x:Name="PART_ButtonNotifications" VerticalAlignment="Center" Margin="10,0,10,0" Height="48" MinWidth="48">
                                        <Button.Content>
                                            <Grid>
                                                <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SeleneInkBrush}" FontSize="26" />
                                                <Ellipse Width="9" Height="9" Fill="{DynamicResource GlyphBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0"/>
                                            </Grid>
                                        </Button.Content>
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ButtonTopMenu}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Api Notifications.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </ButtonEx>
                                    <ButtonEx x:Name="PART_ButtonMainMenu" VerticalAlignment="Center" Style="{DynamicResource ButtonTopMenu}" Margin="10,0,16,0" Height="48" MinWidth="48">
                                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource SeleneInkBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ButtonEx>
                                    <TextBlock x:Name="PART_TextClock" Foreground="{DynamicResource SeleneInkBrush}" FontSize="30" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ================= LOGIN ================= -->
                            <Grid x:Name="AcceuilSettings" Background="{DynamicResource SeleneScrimBrush}">
                                <Grid x:Name="LoginCenterShell"/>
                            </Grid>
                        </Grid>

                        <GameDetails x:Name="PART_ElemGameDetails" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        <GameStatus x:Name="PART_ElemGameStatus" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
