<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- a game's options (Play, Favorite, Hide, Edit fields...), in Selene's shape: a glass card with rounded corners, the
         game's name as its title, the items as rounded rows with Material icons, the focused one filled with the focus color.
         Playnite builds the menu; these are the styles it takes from the theme. -->

    <Style x:Key="GameMenuButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="14,0,14,8" />
        <Setter Property="Padding" Value="20,12,20,13" />
        <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="RowScale" ScaleX="1" ScaleY="1" /></Grid.RenderTransform>
                        <Border x:Name="Fill" CornerRadius="14" Background="{DynamicResource SeleneGlassBrush}" BorderBrush="{DynamicResource SeleneInk15Brush}" BorderThickness="1" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" HorizontalAlignment="Left" VerticalAlignment="Center" TextBlock.Foreground="{DynamicResource SeleneInkBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource SeleneFocusBrush}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource SeleneFocusBrush}" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource SeleneFocusBrush}" />
                            <Setter TargetName="Content" Property="TextBlock.Foreground" Value="{DynamicResource SeleneOnFocusBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.15" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="RowScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameMenuBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Width" Value="520" />
        <Setter Property="Padding" Value="0,0,0,8" />
        <Setter Property="Background" Value="{DynamicResource SeleneGlassSolidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeleneInk15Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="40" Opacity="0.5" Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GameMenuHeaderText" BasedOn="{StaticResource TextBlockBaseStyle}" TargetType="TextBlock" >
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{DynamicResource FontMain}" />
        <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}" />
        <Setter Property="Padding" Value="28,26,28,16" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <DataTemplate x:Key="GameMenuHeaderTemplate">
        <TextBlock Text="{Binding Name}" Style="{DynamicResource GameMenuHeaderText}" />
    </DataTemplate>

    <!-- the items: a Material icon and the words -->
    <DataTemplate x:Key="GameMenuPlayButtonTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xe037;" FontFamily="{DynamicResource FontMaterialIcons}" FontSize="24" Width="30" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBlock Text="{Binding}" FontSize="21" FontFamily="{DynamicResource FontMain}" VerticalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

