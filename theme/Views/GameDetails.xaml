<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    mc:Ignorable="d">

    <!-- Selene game details: the game's hero art full screen; down the left, the logo, the Play / Options pills, the facts,
         the genres as chips, who made it and the scores, then the description on glass that fades out at its foot -->
    <Style x:Key="SeleneDetailsButton" TargetType="ButtonEx">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonEx">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                        <Border x:Name="Glow" CornerRadius="26" Background="{DynamicResource SeleneFocusBrush}" Opacity="0">
                            <Border.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="22" Color="{DynamicResource SeleneFocusColor}" Opacity="0.4"/></Border.Effect>
                        </Border>
                        <!-- dark glass, like the home's pills -->
                        <Border x:Name="Pill" CornerRadius="26" Height="52" MinWidth="{TemplateBinding MinWidth}" Padding="36,0" Background="{DynamicResource SeleneGlassBrush}" BorderBrush="{DynamicResource SeleneInk15Brush}" BorderThickness="1">
                            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource SeleneInkBrush}" TextElement.FontSize="21"
                                              TextElement.FontFamily="Segoe UI Variable Display"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SeleneFocusBrush}"/>
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource SeleneOnFocusBrush}"/>
                            <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="PillScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SeleneStatLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SeleneInk60Brush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>
    <Style x:Key="SeleneStatValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SeleneInkBrush}"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
    <!-- a genre / feature as a small chip -->
    <Style x:Key="SeleneChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="12,4,12,5"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Background" Value="{DynamicResource SeleneInk15Brush}"/>
    </Style>
    <!-- a score badge, gone when there's no score -->
    <Style x:Key="SeleneScoreBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,3,12,4"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="Background" Value="{DynamicResource SeleneGlassBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SeleneInk15Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style TargetType="{x:Type GameDetails}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GameDetails}">
                    <Grid Background="{DynamicResource SeleneScrimBrush}"
                          x:Name="PART_ViewHost"
                          d:DesignWidth="{StaticResource DesignWidth}"
                          d:DesignHeight="{StaticResource DesignHeight}"
                          d:DataContext="{x:Static DesignMainViewModel.DesignSelectedGameIntance}"
                          KeyboardNavigation.DirectionalNavigation="Contained"
                          KeyboardNavigation.TabNavigation="Cycle"
                          KeyboardNavigation.ControlTabNavigation="Cycle">

                        <!-- art: Playnite's background, Selene's hero art over it when there is one -->
                        <FadeImage x:Name="PART_ImageBackground" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
                        <TextBlock x:Name="HeroPath" Tag="{DynamicResource SeleneMediaRoot}" Visibility="Collapsed">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}\Hero\{1}.jpg">
                                    <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                    <Binding Path="Id"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                        <FadeImage Source="{Binding Text, ElementName=HeroPath}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
                        <!-- the words' side dark, the bottom dark, a soft vignette at the edges -->
                        <Border Background="{DynamicResource SeleneScrimBrush}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#F2000000" Offset="0"/>
                                    <GradientStop Color="#B3000000" Offset="0.5"/>
                                    <GradientStop Color="#26000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border Background="{DynamicResource SeleneScrimBrush}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.4"/>
                                    <GradientStop Color="#E6000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Border Background="{DynamicResource SeleneScrimBrush}">
                            <Border.OpacityMask>
                                <RadialGradientBrush RadiusX="0.8" RadiusY="0.9">
                                    <GradientStop Color="#00000000" Offset="0.6"/>
                                    <GradientStop Color="#8C000000" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.OpacityMask>
                        </Border>

                        <StackPanel Margin="110,96,0,0" Width="1060" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <!-- logo, or the name when there is none -->
                            <TextBlock x:Name="LogoPath" Tag="{Api Paths.ConfigurationPath}" Visibility="Collapsed">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0}\ExtraMetadata\games\{1}\logo.png">
                                        <Binding RelativeSource="{RelativeSource Self}" Path="Tag"/>
                                        <Binding Path="Id"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Grid Height="180" HorizontalAlignment="Left">
                                <Image x:Name="Logo" Source="{Binding Text, ElementName=LogoPath, Converter={StaticResource ImageStringToImageConverter}}"
                                       MaxWidth="680" MaxHeight="180" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                       RenderOptions.BitmapScalingMode="Fant"/>
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="62" FontFamily="Segoe UI Variable Display"
                                           FontWeight="SemiBold" VerticalAlignment="Bottom" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source, ElementName=Logo}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- who made it, and the scores -->
                            <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                                <TextBlock FontSize="17" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInk90Brush}" VerticalAlignment="Center" Margin="0,0,18,0">
                                    <Run Text="{Binding Developers, Converter={StaticResource ListToStringConverter}, Mode=OneWay}"/>
                                </TextBlock>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource SeleneScoreBadge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CriticScore}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="15" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInkBrush}">
                                        <Run Text="Critics" Foreground="{DynamicResource SeleneInk60Brush}"/><Run Text=" "/><Run Text="{Binding CriticScore, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </Border>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource SeleneScoreBadge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommunityScore}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="15" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInkBrush}">
                                        <Run Text="Players" Foreground="{DynamicResource SeleneInk60Brush}"/><Run Text=" "/><Run Text="{Binding CommunityScore, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Play / Install / Resume (Playnite fills it in) and Options -->
                            <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                <ButtonEx x:Name="PART_ButtonContext" Style="{StaticResource SeleneDetailsButton}"/>
                                <ButtonEx x:Name="PART_ButtonOptions" Style="{StaticResource SeleneDetailsButton}" Content="{DynamicResource LOCGameOptions}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="4,28,0,0">
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="PLAYTIME" Style="{StaticResource SeleneStatLabel}"/>
                                    <TextBlock Text="{Binding Playtime, Converter={StaticResource PlayTimeToStringConverter}}" Style="{StaticResource SeleneStatValue}"/>
                                </StackPanel>
                                <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,28,4"/>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="LAST PLAYED" Style="{StaticResource SeleneStatLabel}"/>
                                    <TextBlock Text="{Binding LastActivity, Converter={StaticResource DateTimeToLastPlayedConverter}}" Style="{StaticResource SeleneStatValue}"/>
                                </StackPanel>
                                <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,28,4"/>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="RELEASED" Style="{StaticResource SeleneStatLabel}"/>
                                    <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource SeleneStatValue}"/>
                                </StackPanel>
                                <Rectangle Width="1" Fill="{DynamicResource SeleneInk25Brush}" Margin="0,4,28,4"/>
                                <StackPanel>
                                    <!-- the store's mark and name, as Spotlight shows it (a PC game said "PC (Windows)") -->
                                    <TextBlock Text="PLATFORM" Style="{StaticResource SeleneStatLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Grid Width="22" Height="22" Margin="0,0,9,0" VerticalAlignment="Center">
                                            <Path Data="{DynamicResource SelenePlatformIcon}" Fill="{DynamicResource SeleneInkBrush}" Stretch="Uniform"/>
                                            <TextBlock Text="&#xEA12;" FontFamily="{DynamicResource SeleneIconFont}" FontSize="21" Foreground="{DynamicResource SeleneInkBrush}" VerticalAlignment="Center" Visibility="{DynamicResource SelenePlatformFallback}"/>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource SelenePlatformName}" Foreground="{DynamicResource SeleneInkBrush}" FontSize="21" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- the genres as chips -->
                            <ItemsControl ItemsSource="{Binding Genres}" Margin="2,22,0,0" IsTabStop="False" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SeleneChip}">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneInk90Brush}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- the description on glass, fading out at its foot (the right stick / page keys scroll it) -->
                            <Border Margin="0,14,0,0" MaxHeight="300" CornerRadius="18" Background="{DynamicResource SeleneGlassBrush}" BorderThickness="0" Padding="26,20,26,30" HorizontalAlignment="Left" MinWidth="700">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF000000" Offset="0"/>
                                        <GradientStop Color="#FF000000" Offset="0.78"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                                <ScrollViewerEx x:Name="PART_ScrollHtmlDescription" CustomScrollAmount="42" VerticalScrollBarVisibility="Hidden">
                                    <HtmlTextView x:Name="PART_HtmlDescription" HtmlFontSize="17"
                                                  HtmlForeground="{DynamicResource SeleneInkColor}" LinkForeground="{DynamicResource GlyphColor}" FocusVisualStyle="{x:Null}"/>
                                </ScrollViewerEx>
                            </Border>
                        </StackPanel>

                        <!-- the game's screenshots along the bottom (Selene Core publishes them for the selected game) -->
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="110,0,0,96">
                            <TextBlock Text="SCREENSHOTS" Style="{StaticResource SeleneStatLabel}" Margin="2,0,0,10" Visibility="{DynamicResource SeleneShot0Vis}"/>
                            <StackPanel Orientation="Horizontal">
                            <Border Width="272" Height="153" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True" Background="{DynamicResource SeleneGlassSolidBrush}" Visibility="{DynamicResource SeleneShot0Vis}">
                                <Image Source="{DynamicResource SeleneShot0}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border Width="272" Height="153" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True" Background="{DynamicResource SeleneGlassSolidBrush}" Visibility="{DynamicResource SeleneShot1Vis}">
                                <Image Source="{DynamicResource SeleneShot1}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border Width="272" Height="153" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True" Background="{DynamicResource SeleneGlassSolidBrush}" Visibility="{DynamicResource SeleneShot2Vis}">
                                <Image Source="{DynamicResource SeleneShot2}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border Width="272" Height="153" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True" Background="{DynamicResource SeleneGlassSolidBrush}" Visibility="{DynamicResource SeleneShot3Vis}">
                                <Image Source="{DynamicResource SeleneShot3}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border Width="272" Height="153" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True" Background="{DynamicResource SeleneGlassSolidBrush}" Visibility="{DynamicResource SeleneShot4Vis}">
                                <Image Source="{DynamicResource SeleneShot4}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border Width="272" Height="153" CornerRadius="12" Margin="0,0,20,0" ClipToBounds="True" Background="{DynamicResource SeleneGlassSolidBrush}" Visibility="{DynamicResource SeleneShot5Vis}">
                                <Image Source="{DynamicResource SeleneShot5}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- the hints along the bottom -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="80,0,0,38">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{DynamicResource SeleneInkBrush}"/>
                                <TextBlock Text="B" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneScrimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            </Grid>
                            <TextBlock Text="Back" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="21" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,2"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,80,38">
                            <Grid Width="32" Height="32">
                                <Ellipse Fill="{DynamicResource SeleneInkBrush}"/>
                                <TextBlock Text="A" FontSize="16" FontWeight="SemiBold" FontFamily="Segoe UI" Foreground="{DynamicResource SeleneScrimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            </Grid>
                            <TextBlock Text="Select" Foreground="{DynamicResource SeleneInk90Brush}" FontSize="21" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="10,0,0,2"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
