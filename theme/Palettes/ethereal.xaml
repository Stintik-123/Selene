<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/ethereal.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">ethereal</sys:String>
    <sys:String x:Key="SeleneThemeName">Ethereal</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/ethereal/1-cosmic.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF7D82D9</Color>
    <Color x:Key="GlyphLightColor">#FFFFCEAD</Color>
    <Color x:Key="SelectionLightColor">#FFC9B8A6</Color>
    <Color x:Key="OverlayColor">#CC030610</Color>
    <Color x:Key="ControlBackgroundColor">#FF131A3A</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF040816</Color>
    <Color x:Key="TextColor">#FFFFCEAD</Color>
    <Color x:Key="TextColorDark">#FF6D7DB6</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF131A3A" Offset="0" />
        <GradientStop Color="#FF030610" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF040816" Offset="0" />
        <GradientStop Color="#AA030610" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF040816" Offset="0" />
        <GradientStop Color="#AA030610" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2131A3A" Offset="0" />
        <GradientStop Color="#F2030610" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00040816" Offset="0.0" />
        <GradientStop Color="#EE030610" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFED5B5A" />
</ResourceDictionary>
