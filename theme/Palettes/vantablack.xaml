<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/vantablack.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">vantablack</sys:String>
    <sys:String x:Key="SeleneThemeName">Vantablack</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/vantablack/0-dot-hands.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF8D8D8D</Color>
    <Color x:Key="GlyphLightColor">#FFFFFFFF</Color>
    <Color x:Key="SelectionLightColor">#FFECECEC</Color>
    <Color x:Key="OverlayColor">#CC070707</Color>
    <Color x:Key="ControlBackgroundColor">#FF1A1A1A</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF090909</Color>
    <Color x:Key="TextColor">#FFFFFFFF</Color>
    <Color x:Key="TextColorDark">#FF505050</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF1A1A1A" Offset="0" />
        <GradientStop Color="#FF070707" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF090909" Offset="0" />
        <GradientStop Color="#AA070707" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF090909" Offset="0" />
        <GradientStop Color="#AA070707" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F21A1A1A" Offset="0" />
        <GradientStop Color="#F2070707" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00090909" Offset="0.0" />
        <GradientStop Color="#EE070707" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFA4A4A4" />
</ResourceDictionary>
