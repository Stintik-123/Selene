<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/selene.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">selene</sys:String>
    <sys:String x:Key="SeleneThemeName">Selene</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper"></sys:String>

    <Color x:Key="GlyphColor">#FF9CCBFF</Color>
    <Color x:Key="GlyphLightColor">#FFEAF3FF</Color>
    <Color x:Key="SelectionLightColor">#FFB8C7DD</Color>
    <Color x:Key="OverlayColor">#CC03081A</Color>
    <Color x:Key="ControlBackgroundColor">#FF1A2A4A</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0A142C</Color>
    <Color x:Key="TextColor">#FFEBEBEB</Color>
    <Color x:Key="TextColorDark">#FF757575</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF102A5C" Offset="0" />
        <GradientStop Color="#FF03081A" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF0A142C" Offset="0" />
        <GradientStop Color="#AA03081A" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF0A142C" Offset="0" />
        <GradientStop Color="#AA03081A" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2102A5C" Offset="0" />
        <GradientStop Color="#F203081A" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#000A142C" Offset="0.0" />
        <GradientStop Color="#EE03081A" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF6B6B" />
</ResourceDictionary>
