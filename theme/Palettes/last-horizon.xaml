<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/last-horizon.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">last-horizon</sys:String>
    <sys:String x:Key="SeleneThemeName">Last Horizon</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/last-horizon/1-eyes-wide.jpg</sys:String>

    <Color x:Key="GlyphColor">#FFB59790</Color>
    <Color x:Key="GlyphLightColor">#FFE2DDDC</Color>
    <Color x:Key="SelectionLightColor">#FFCFD3CD</Color>
    <Color x:Key="OverlayColor">#CC060606</Color>
    <Color x:Key="ControlBackgroundColor">#FF0C0B0C</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF090809</Color>
    <Color x:Key="TextColor">#FFFAFCFB</Color>
    <Color x:Key="TextColorDark">#FF584E51</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF0C0B0C" Offset="0" />
        <GradientStop Color="#FF060606" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF090809" Offset="0" />
        <GradientStop Color="#AA060606" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF090809" Offset="0" />
        <GradientStop Color="#AA060606" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F20C0B0C" Offset="0" />
        <GradientStop Color="#F2060606" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00090809" Offset="0.0" />
        <GradientStop Color="#EE060606" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC38B7B" />
</ResourceDictionary>
