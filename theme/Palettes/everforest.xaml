<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/everforest.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">everforest</sys:String>
    <sys:String x:Key="SeleneThemeName">Everforest</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/everforest/1-tree-tops.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF7FBBB3</Color>
    <Color x:Key="GlyphLightColor">#FFD3C6AA</Color>
    <Color x:Key="SelectionLightColor">#FF9DA9A0</Color>
    <Color x:Key="OverlayColor">#CC181D20</Color>
    <Color x:Key="ControlBackgroundColor">#FF343F44</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF21272C</Color>
    <Color x:Key="TextColor">#FFD3C6AA</Color>
    <Color x:Key="TextColorDark">#FF4F585E</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF343F44" Offset="0" />
        <GradientStop Color="#FF181D20" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF21272C" Offset="0" />
        <GradientStop Color="#AA181D20" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF21272C" Offset="0" />
        <GradientStop Color="#AA181D20" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2343F44" Offset="0" />
        <GradientStop Color="#F2181D20" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#0021272C" Offset="0.0" />
        <GradientStop Color="#EE181D20" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFE67E80" />
</ResourceDictionary>
