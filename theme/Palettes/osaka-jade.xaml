<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/osaka-jade.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">osaka-jade</sys:String>
    <sys:String x:Key="SeleneThemeName">Osaka Jade</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/osaka-jade/1-glowing-city.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF509475</Color>
    <Color x:Key="GlyphLightColor">#FFF7E8B2</Color>
    <Color x:Key="SelectionLightColor">#FFD6D5BC</Color>
    <Color x:Key="OverlayColor">#CC090F0D</Color>
    <Color x:Key="ControlBackgroundColor">#FF23372B</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0C1512</Color>
    <Color x:Key="TextColor">#FFC1C497</Color>
    <Color x:Key="TextColorDark">#FF81B8A8</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF23372B" Offset="0" />
        <GradientStop Color="#FF090F0D" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF0C1512" Offset="0" />
        <GradientStop Color="#AA090F0D" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF0C1512" Offset="0" />
        <GradientStop Color="#AA090F0D" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F223372B" Offset="0" />
        <GradientStop Color="#F2090F0D" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#000C1512" Offset="0.0" />
        <GradientStop Color="#EE090F0D" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF5345" />
</ResourceDictionary>
