<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/retro-82.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">retro-82</sys:String>
    <sys:String x:Key="SeleneThemeName">Retro 82</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/retro-82/1-in-the-groove.jpg</sys:String>

    <Color x:Key="GlyphColor">#FFFAA968</Color>
    <Color x:Key="GlyphLightColor">#FFF6DCAC</Color>
    <Color x:Key="SelectionLightColor">#FFA7C9C6</Color>
    <Color x:Key="OverlayColor">#CC020C17</Color>
    <Color x:Key="ControlBackgroundColor">#FF0A2540</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF031222</Color>
    <Color x:Key="TextColor">#FFF6DCAC</Color>
    <Color x:Key="TextColorDark">#FF3F8F8A</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF0A2540" Offset="0" />
        <GradientStop Color="#FF020C17" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF031222" Offset="0" />
        <GradientStop Color="#AA020C17" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF031222" Offset="0" />
        <GradientStop Color="#AA020C17" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F20A2540" Offset="0" />
        <GradientStop Color="#F2020C17" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00031222" Offset="0.0" />
        <GradientStop Color="#EE020C17" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF85525" />
</ResourceDictionary>
