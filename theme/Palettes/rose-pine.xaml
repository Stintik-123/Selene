<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/rose-pine.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">rose-pine</sys:String>
    <sys:String x:Key="SeleneThemeName">Rosé Pine</sys:String>
    <sys:String x:Key="SeleneThemeMode">light</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/rose-pine/1-funky-shapes.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF56949F</Color>
    <Color x:Key="GlyphLightColor">#FF575279</Color>
    <Color x:Key="SelectionLightColor">#FF6E6A86</Color>
    <Color x:Key="OverlayColor">#CCE1DBD5</Color>
    <Color x:Key="ControlBackgroundColor">#FFF2E9E1</Color>
    <Color x:Key="ControlBackgroundColorDark">#FFEDE7E1</Color>
    <Color x:Key="TextColor">#FF575279</Color>
    <Color x:Key="TextColorDark">#FF9893A5</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FFF2E9E1" Offset="0" />
        <GradientStop Color="#FFE1DBD5" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFEDE7E1" Offset="0" />
        <GradientStop Color="#AAE1DBD5" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FFEDE7E1" Offset="0" />
        <GradientStop Color="#AAE1DBD5" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2F2E9E1" Offset="0" />
        <GradientStop Color="#F2E1DBD5" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00EDE7E1" Offset="0.0" />
        <GradientStop Color="#EEE1DBD5" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB4637A" />
</ResourceDictionary>
