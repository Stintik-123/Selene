<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/ristretto.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">ristretto</sys:String>
    <sys:String x:Key="SeleneThemeName">Ristretto</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/ristretto/0-launch.png</sys:String>

    <Color x:Key="GlyphColor">#FFF38D70</Color>
    <Color x:Key="GlyphLightColor">#FFE6D9DB</Color>
    <Color x:Key="SelectionLightColor">#FFC3B7B8</Color>
    <Color x:Key="OverlayColor">#CC181414</Color>
    <Color x:Key="ControlBackgroundColor">#FF3D2F2A</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF211B1B</Color>
    <Color x:Key="TextColor">#FFE6D9DB</Color>
    <Color x:Key="TextColorDark">#FF72696A</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF3D2F2A" Offset="0" />
        <GradientStop Color="#FF181414" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF211B1B" Offset="0" />
        <GradientStop Color="#AA181414" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF211B1B" Offset="0" />
        <GradientStop Color="#AA181414" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F23D2F2A" Offset="0" />
        <GradientStop Color="#F2181414" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00211B1B" Offset="0.0" />
        <GradientStop Color="#EE181414" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFD6883" />
</ResourceDictionary>
