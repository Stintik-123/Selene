<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/catppuccin-latte.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">catppuccin-latte</sys:String>
    <sys:String x:Key="SeleneThemeName">Catppuccin Latte</sys:String>
    <sys:String x:Key="SeleneThemeMode">light</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/catppuccin-latte/1-color-fade.png</sys:String>

    <Color x:Key="GlyphColor">#FF1E66F5</Color>
    <Color x:Key="GlyphLightColor">#FF4C4F69</Color>
    <Color x:Key="SelectionLightColor">#FF5C5F77</Color>
    <Color x:Key="OverlayColor">#CCD7D8DC</Color>
    <Color x:Key="ControlBackgroundColor">#FFDCE0E8</Color>
    <Color x:Key="ControlBackgroundColorDark">#FFE3E4E8</Color>
    <Color x:Key="TextColor">#FF4C4F69</Color>
    <Color x:Key="TextColorDark">#FF9CA0B0</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FFDCE0E8" Offset="0" />
        <GradientStop Color="#FFD7D8DC" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFE3E4E8" Offset="0" />
        <GradientStop Color="#AAD7D8DC" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FFE3E4E8" Offset="0" />
        <GradientStop Color="#AAD7D8DC" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2DCE0E8" Offset="0" />
        <GradientStop Color="#F2D7D8DC" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00E3E4E8" Offset="0.0" />
        <GradientStop Color="#EED7D8DC" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD20F39" />
</ResourceDictionary>
