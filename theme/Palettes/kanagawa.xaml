        <GradientStop Color="#FF17171E" Offset="0" />
        <GradientStop Color="#AA111116" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2223249" Offset="0" />
        <GradientStop Color="#F2111116" Offset="1.0" />
