    <sys:String x:Key="SeleneThemeName">Kanagawa</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/kanagawa/1-kanagawa.jpg</sys:String>

    <Color x:Key="GlyphColor">#FFDCD7BA</Color>
