<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/miasma.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">miasma</sys:String>
    <sys:String x:Key="SeleneThemeName">Miasma</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/miasma/01-nature-of-fear.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF78824B</Color>
    <Color x:Key="GlyphLightColor">#FFC2C2B0</Color>
    <Color x:Key="SelectionLightColor">#FF8A8A7E</Color>
    <Color x:Key="OverlayColor">#CC121212</Color>
    <Color x:Key="ControlBackgroundColor">#FF2C2C2C</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF191919</Color>
    <Color x:Key="TextColor">#FFC2C2B0</Color>
    <Color x:Key="TextColorDark">#FF555555</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF2C2C2C" Offset="0" />
        <GradientStop Color="#FF121212" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF191919" Offset="0" />
        <GradientStop Color="#AA121212" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF191919" Offset="0" />
        <GradientStop Color="#AA121212" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F22C2C2C" Offset="0" />
        <GradientStop Color="#F2121212" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00191919" Offset="0.0" />
        <GradientStop Color="#EE121212" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF685742" />
</ResourceDictionary>
