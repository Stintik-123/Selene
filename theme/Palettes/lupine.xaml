<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/lupine.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">lupine</sys:String>
    <sys:String x:Key="SeleneThemeName">Lupine</sys:String>
    <sys:String x:Key="SeleneThemeMode">light</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/lupine/01-cherry-blossom-bokeh.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF3264EB</Color>
    <Color x:Key="GlyphLightColor">#FF000000</Color>
    <Color x:Key="SelectionLightColor">#FF424242</Color>
    <Color x:Key="OverlayColor">#CCDEDEDE</Color>
    <Color x:Key="ControlBackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="ControlBackgroundColorDark">#FFECECEC</Color>
    <Color x:Key="TextColor">#FF212121</Color>
    <Color x:Key="TextColorDark">#FF757575</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FFF5F5F5" Offset="0" />
        <GradientStop Color="#FFDEDEDE" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFECECEC" Offset="0" />
        <GradientStop Color="#AADEDEDE" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FFECECEC" Offset="0" />
        <GradientStop Color="#AADEDEDE" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2F5F5F5" Offset="0" />
        <GradientStop Color="#F2DEDEDE" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00ECECEC" Offset="0.0" />
        <GradientStop Color="#EEDEDEDE" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC900C4" />
</ResourceDictionary>
