<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/tokyo-night.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">tokyo-night</sys:String>
    <sys:String x:Key="SeleneThemeName">Tokyo Night</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/tokyo-night/0-winding-road.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF7AA2F7</Color>
    <Color x:Key="GlyphLightColor">#FFC0CAF5</Color>
    <Color x:Key="SelectionLightColor">#FFB4BEE6</Color>
    <Color x:Key="OverlayColor">#CC0E0E14</Color>
    <Color x:Key="ControlBackgroundColor">#FF24283B</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF13141C</Color>
    <Color x:Key="TextColor">#FFA9B1D6</Color>
    <Color x:Key="TextColorDark">#FF565F89</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF24283B" Offset="0" />
        <GradientStop Color="#FF0E0E14" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF13141C" Offset="0" />
        <GradientStop Color="#AA0E0E14" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF13141C" Offset="0" />
        <GradientStop Color="#AA0E0E14" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F224283B" Offset="0" />
        <GradientStop Color="#F20E0E14" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#0013141C" Offset="0.0" />
        <GradientStop Color="#EE0E0E14" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFF7768E" />
</ResourceDictionary>
