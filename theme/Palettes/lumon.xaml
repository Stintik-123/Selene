<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/lumon.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">lumon</sys:String>
    <sys:String x:Key="SeleneThemeName">Frost</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/lumon/01-united-in-severance.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF8BC9EB</Color>
    <Color x:Key="GlyphLightColor">#FFF2FCFF</Color>
    <Color x:Key="SelectionLightColor">#FFD6E2EE</Color>
    <Color x:Key="OverlayColor">#CC0B1216</Color>
    <Color x:Key="ControlBackgroundColor">#FF1B2D40</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF101B21</Color>
    <Color x:Key="TextColor">#FFD6E2EE</Color>
    <Color x:Key="TextColorDark">#FF4D86B0</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF1B2D40" Offset="0" />
        <GradientStop Color="#FF0B1216" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF101B21" Offset="0" />
        <GradientStop Color="#AA0B1216" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF101B21" Offset="0" />
        <GradientStop Color="#AA0B1216" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F21B2D40" Offset="0" />
        <GradientStop Color="#F20B1216" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00101B21" Offset="0.0" />
        <GradientStop Color="#EE0B1216" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF4D86B0" />
</ResourceDictionary>
