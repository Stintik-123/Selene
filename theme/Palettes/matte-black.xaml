<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/matte-black.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">matte-black</sys:String>
    <sys:String x:Key="SeleneThemeName">Matte Black</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/matte-black/0-ship-at-sea.jpg</sys:String>

    <Color x:Key="GlyphColor">#FFE68E0D</Color>
    <Color x:Key="GlyphLightColor">#FFBEBEBE</Color>
    <Color x:Key="SelectionLightColor">#FF8A8A8D</Color>
    <Color x:Key="OverlayColor">#CC090909</Color>
    <Color x:Key="ControlBackgroundColor">#FF1E1E1E</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0D0D0D</Color>
    <Color x:Key="TextColor">#FFBEBEBE</Color>
    <Color x:Key="TextColorDark">#FF555555</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF1E1E1E" Offset="0" />
        <GradientStop Color="#FF090909" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF0D0D0D" Offset="0" />
        <GradientStop Color="#AA090909" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF0D0D0D" Offset="0" />
        <GradientStop Color="#AA090909" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F21E1E1E" Offset="0" />
        <GradientStop Color="#F2090909" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#000D0D0D" Offset="0.0" />
        <GradientStop Color="#EE090909" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD35F5F" />
</ResourceDictionary>
