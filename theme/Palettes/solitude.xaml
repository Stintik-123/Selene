<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/solitude.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">solitude</sys:String>
    <sys:String x:Key="SeleneThemeName">Solitude</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/solitude/1-on-pole.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF798186</Color>
    <Color x:Key="GlyphLightColor">#FFA5AEB4</Color>
    <Color x:Key="SelectionLightColor">#FFCBC2BE</Color>
    <Color x:Key="OverlayColor">#CC080A0B</Color>
    <Color x:Key="ControlBackgroundColor">#FF101315</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF0C0E10</Color>
    <Color x:Key="TextColor">#FFCACCCC</Color>
    <Color x:Key="TextColorDark">#FF4B4E55</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF101315" Offset="0" />
        <GradientStop Color="#FF080A0B" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF0C0E10" Offset="0" />
        <GradientStop Color="#AA080A0B" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF0C0E10" Offset="0" />
        <GradientStop Color="#AA080A0B" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2101315" Offset="0" />
        <GradientStop Color="#F2080A0B" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#000C0E10" Offset="0.0" />
        <GradientStop Color="#EE080A0B" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF565D60" />
</ResourceDictionary>
