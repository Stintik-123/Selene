<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/white.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">white</sys:String>
    <sys:String x:Key="SeleneThemeName">White</sys:String>
    <sys:String x:Key="SeleneThemeMode">light</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/white/1-white.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF6E6E6E</Color>
    <Color x:Key="GlyphLightColor">#FF000000</Color>
    <Color x:Key="SelectionLightColor">#FF000000</Color>
    <Color x:Key="OverlayColor">#CCE8E8E8</Color>
    <Color x:Key="ControlBackgroundColor">#FFC0C0C0</Color>
    <Color x:Key="ControlBackgroundColorDark">#FFF5F5F5</Color>
    <Color x:Key="TextColor">#FF000000</Color>
    <Color x:Key="TextColorDark">#FFC0C0C0</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FFC0C0C0" Offset="0" />
        <GradientStop Color="#FFE8E8E8" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FFF5F5F5" Offset="0" />
        <GradientStop Color="#AAE8E8E8" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FFF5F5F5" Offset="0" />
        <GradientStop Color="#AAE8E8E8" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F2C0C0C0" Offset="0" />
        <GradientStop Color="#F2E8E8E8" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00F5F5F5" Offset="0.0" />
        <GradientStop Color="#EEE8E8E8" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF2A2A2A" />
</ResourceDictionary>
