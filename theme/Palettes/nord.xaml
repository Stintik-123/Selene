<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Generated by tools/make_palettes.py from tools/palettes/nord.toml - edit the .toml, not this file -->
    <sys:String x:Key="SeleneThemeId">nord</sys:String>
    <sys:String x:Key="SeleneThemeName">Nord</sys:String>
    <sys:String x:Key="SeleneThemeMode">dark</sys:String>
    <sys:String x:Key="SeleneDefaultWallpaper">Wallpapers/nord/0-black-moon.jpg</sys:String>

    <Color x:Key="GlyphColor">#FF81A1C1</Color>
    <Color x:Key="GlyphLightColor">#FFD8DEE9</Color>
    <Color x:Key="SelectionLightColor">#FFADB5C4</Color>
    <Color x:Key="OverlayColor">#CC191C23</Color>
    <Color x:Key="ControlBackgroundColor">#FF3B4252</Color>
    <Color x:Key="ControlBackgroundColorDark">#FF222730</Color>
    <Color x:Key="TextColor">#FFD8DEE9</Color>
    <Color x:Key="TextColorDark">#FF667080</Color>

    <RadialGradientBrush x:Key="MainBackgourndBrush" GradientOrigin="0.5,0.1" Center="0.5,0.2" RadiusX="0.5" RadiusY="0.7">
        <GradientStop Color="#FF3B4252" Offset="0" />
        <GradientStop Color="#FF191C23" Offset="1.0" />
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1,0.5">
        <GradientStop Color="#FF222730" Offset="0" />
        <GradientStop Color="#AA191C23" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BottomBarBackgroundBrush" StartPoint="-0.5,0.5" EndPoint="1.5,1">
        <GradientStop Color="#FF222730" Offset="0" />
        <GradientStop Color="#AA191C23" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OverlayMenuBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,1.5">
        <GradientStop Color="#F23B4252" Offset="0" />
        <GradientStop Color="#F2191C23" Offset="1.0" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GameDetailsBackgroundBrush" StartPoint="0.5,0" EndPoint="0.5,0.4">
        <GradientStop Color="#00222730" Offset="0.0" />
        <GradientStop Color="#EE191C23" Offset="0.8" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFBF616A" />
</ResourceDictionary>
